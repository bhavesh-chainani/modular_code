# Copy to deploy/clients/<client>.env for each client. Real client files are git-ignored.

# --- Langflow ---
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=change-me
LANGFLOW_SECRET_KEY=change-me
LANGFLOW_MCP_SERVERS_LOCKED=true
LANGFLOW_MCP_SSE_ENABLED=false

# --- LLM access via a LiteLLM proxy (recommended; read by LiteLLM itself) ---
# Model names below are then the proxy's names, e.g. vertex_ai.anthropic.claude-sonnet-5-5
USE_LITELLM_PROXY=true
LITELLM_PROXY_API_BASE=https://genai-sharedservice-americas.pwc.com
LITELLM_PROXY_API_KEY=
# Use the bundled price list instead of fetching it from GitHub at startup (blocked by corporate TLS inspection).
LITELLM_LOCAL_MODEL_COST_MAP=True

# --- modkit ---
MODKIT_DEFAULT_MODEL=vertex_ai.anthropic.claude-sonnet-5-5
MODKIT_MODEL_CHOICES=vertex_ai.anthropic.claude-sonnet-5-5,vertex_ai.anthropic.claude-opus-5-5,vertex_ai.anthropic.claude-haiku-5-5,openai.gpt-5
MODKIT_SMTP_HOST=mailpit
MODKIT_SMTP_PORT=1025
MODKIT_SMTP_STARTTLS=false
MODKIT_SMTP_USER=
MODKIT_SMTP_PASSWORD=
MODKIT_EMAIL_FROM=reports@example.com

# --- Direct provider keys: only if NOT using the proxy (then use names like anthropic/claude-sonnet-5-5) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Langfuse: one Langfuse project per client. Leave keys empty to disable tracing. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://host.docker.internal:3000
# Keeps test runs apart from real traffic in the same project: production | staging | development
LANGFUSE_TRACING_ENVIRONMENT=production
